.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
data/manifests/paper_v2/*.jsonl text eol=lf
data/manifests/noise/paper_v2/*.jsonl text eol=lf
data/manifests/fleurs/paper_v2/*.jsonl text eol=lf
outputs/paper_v2/protocol/*.csv text eol=lf
outputs/paper_v2/**/*.csv text eol=lf
outputs/paper_v2/benchmark/final_benchmark_manifest.jsonl text eol=lf
# This is the only dataset audio path published by this repository.  The
# benchmark WAVs must be LFS objects, never ordinary Git blobs.
data/derived/paper_v2/final_benchmark/**/*.wav filter=lfs diff=lfs merge=lfs -text
# Store trained model states in Git LFS.
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
# Preserve byte-identical paper-v2 checkpoint fingerprints across platforms.
outputs/paper_v2/checkpoints/*/best/** -text whitespace=cr-at-eol
outputs/paper_v2/**/error_events.csv filter=lfs diff=lfs merge=lfs -text
