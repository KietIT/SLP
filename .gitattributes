.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
data/manifests/paper_v2/*.jsonl text eol=lf
data/manifests/noise/paper_v2/*.jsonl text eol=lf
data/manifests/fleurs/paper_v2/*.jsonl text eol=lf
